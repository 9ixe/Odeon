<Page
    x:Class="Odeon.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:Odeon.Controls"
    xmlns:converters="using:Odeon.Converters"
    xmlns:ctc="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Odeon.Extensions"
    xmlns:helpers="using:Odeon.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:strings="using:Odeon.Strings"
    xmlns:triggers="using:Odeon.Triggers"
    xmlns:ui="using:CommunityToolkit.WinUI"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    FontFamily="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular"
    extensions:ApplicationViewExtensions.Title="{x:Bind ViewModel.Media.Name, Mode=OneWay, FallbackValue={}}"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    IsTabStop="True"
    Loaded="OnLoaded"
    Loading="OnLoading"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="BackgroundAcrylicTintColor">#0F0F0F</Color>
                    <Color x:Key="BackgroundAcrylicTintFallbackColor">#0F0F0F</Color>
                    <x:Double x:Key="BackgroundAcrylicTintOpacity">0.5</x:Double>

                    <media:AcrylicBrush
                        x:Key="SidePanelBackgroundBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="#1E1E1E"
                        TintColor="#141414"
                        TintOpacity="0.88" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#33FFFFFF" />

                    <LinearGradientBrush x:Key="PlayerTitleBarBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="0.5" Color="#00000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlayerControlsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BackgroundAcrylicTintColor">#FCFCFC</Color>
                    <Color x:Key="BackgroundAcrylicTintFallbackColor">#F9F9F9</Color>
                    <x:Double x:Key="BackgroundAcrylicTintOpacity">0.15</x:Double>

                    <media:AcrylicBrush
                        x:Key="SidePanelBackgroundBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="#F4F4F4"
                        TintColor="#FAFAFA"
                        TintOpacity="0.88" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#22000000" />

                    <LinearGradientBrush x:Key="PlayerTitleBarBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.5" Color="#00FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlayerControlsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="BackgroundAcrylicTintColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="BackgroundAcrylicTintFallbackColor" ResourceKey="SystemColorWindowColor" />
                    <x:Double x:Key="BackgroundAcrylicTintOpacity">1</x:Double>

                    <SolidColorBrush x:Key="SidePanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

                    <StaticResource x:Key="ProgressBarBackground" ResourceKey="SystemColorButtonTextColorBrush" />
                    <Thickness x:Key="ProgressBarBorderThemeThickness">0</Thickness>

                    <StaticResource x:Key="PlayerTitleBarBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PlayerControlsBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Thickness x:Key="PlayerTitleBarButtonMargin">4,-24,0,0</Thickness>

            <Storyboard x:Name="OpenSubtitlePanelStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelTransform"
                    Storyboard.TargetProperty="X"
                    From="440"
                    To="0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.15" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelBackdrop"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.25" />
            </Storyboard>

            <Storyboard x:Name="CloseSubtitlePanelStoryboard" Completed="CloseSubtitlePanelStoryboard_OnCompleted">
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelTransform"
                    Storyboard.TargetProperty="X"
                    From="0"
                    To="440"
                    Duration="0:0:0.28">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.1" EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelBackdrop"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>

            <Storyboard x:Name="OpenAudioPanelStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="AudioPanelTransform"
                    Storyboard.TargetProperty="X"
                    From="440"
                    To="0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.15" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelBackdrop"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.25" />
            </Storyboard>

            <Storyboard x:Name="CloseAudioPanelStoryboard" Completed="CloseAudioPanelStoryboard_OnCompleted">
                <DoubleAnimation
                    Storyboard.TargetName="AudioPanelTransform"
                    Storyboard.TargetProperty="X"
                    From="0"
                    To="440"
                    Duration="0:0:0.28">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.1" EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelBackdrop"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>

            <Storyboard x:Name="OpenPlayQueuePanelStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="PlayQueuePanelTransform"
                    Storyboard.TargetProperty="X"
                    From="540"
                    To="0"
                    Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.15" EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelBackdrop"
                    Storyboard.TargetProperty="Opacity"
                    From="0"
                    To="1"
                    Duration="0:0:0.25" />
            </Storyboard>

            <Storyboard x:Name="ClosePlayQueuePanelStoryboard" Completed="ClosePlayQueuePanelStoryboard_OnCompleted">
                <DoubleAnimation
                    Storyboard.TargetName="PlayQueuePanelTransform"
                    Storyboard.TargetProperty="X"
                    From="0"
                    To="540"
                    Duration="0:0:0.28">
                    <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.1" EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation
                    Storyboard.TargetName="SubtitlePanelBackdrop"
                    Storyboard.TargetProperty="Opacity"
                    From="1"
                    To="0"
                    Duration="0:0:0.2" />
            </Storyboard>
            <Storyboard x:Name="PlayPauseBadgeStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayerStateBadge" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.0" KeySpline="0.1,0.9,0.2,1.0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="1.0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.85" Value="0.0" KeySpline="0.7,0.0,0.9,0.1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayerStateBadgeTransform" Storyboard.TargetProperty="ScaleX">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.75" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="1.0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.85" Value="1.1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseIn" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayerStateBadgeTransform" Storyboard.TargetProperty="ScaleY">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.75" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <LinearDoubleKeyFrame KeyTime="0:0:0.60" Value="1.0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.85" Value="1.1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CubicEase EasingMode="EaseIn" />
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <Grid
            x:Name="LayoutRoot"
            KeyboardAcceleratorPlacementMode="Hidden"
            PointerMoved="{x:Bind ViewModel.OnPointerMoved}"
            PreviewKeyDown="LayoutRoot_OnPreviewKeyDown"
            PreviewKeyUp="LayoutRoot_OnPreviewKeyUp">
            <Grid.Transitions>
                <TransitionCollection>
                    <PaneThemeTransition Edge="Bottom" />
                </TransitionCollection>
            </Grid.Transitions>
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FirstColumn" Width="*" />
            <ColumnDefinition x:Name="SecondColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid.KeyboardAccelerators>
            <!--  Volume  -->
            <KeyboardAccelerator Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemPlus}" Invoked="ChangeVolumeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Add" Invoked="ChangeVolumeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemMinus}" Invoked="ChangeVolumeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Subtract" Invoked="ChangeVolumeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Up" Invoked="ChangeVolumeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Down" Invoked="ChangeVolumeKeyboardAccelerator_OnInvoked" />
            <!--  Seek  -->
            <KeyboardAccelerator Key="Left" Invoked="SeekKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="SeekKeyboardAccelerator_OnInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Left"
                Invoked="SeekKeyboardAccelerator_OnInvoked"
                Modifiers="Shift" />
            <KeyboardAccelerator Key="Right" Invoked="SeekKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator
                Key="Right"
                Invoked="SeekKeyboardAccelerator_OnInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Right"
                Invoked="SeekKeyboardAccelerator_OnInvoked"
                Modifiers="Shift" />
            <KeyboardAccelerator Key="J" Invoked="SeekKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="L" Invoked="SeekKeyboardAccelerator_OnInvoked" />
            <!--  Frame stepping  -->
            <KeyboardAccelerator Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemPeriod}" Invoked="FrameSteppingKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemComma}" Invoked="FrameSteppingKeyboardAccelerator_OnInvoked" />
            <!--  Playback speed  -->
            <KeyboardAccelerator
                Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemPeriod}"
                Invoked="PlaybackRateKeyboardAccelerator_OnInvoked"
                Modifiers="Shift" />
            <KeyboardAccelerator
                Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemComma}"
                Invoked="PlaybackRateKeyboardAccelerator_OnInvoked"
                Modifiers="Shift" />
            <!--  Window resize  -->
            <KeyboardAccelerator
                Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemPlus}"
                Invoked="WindowResizeKeyboardAccelerator_OnInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="{x:Bind helpers:KeyboardAcceleratorHelper.OemMinus}"
                Invoked="WindowResizeKeyboardAccelerator_OnInvoked"
                Modifiers="Control" />
            <KeyboardAccelerator Key="Number1" Invoked="WindowResizeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Number2" Invoked="WindowResizeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Number3" Invoked="WindowResizeKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Number4" Invoked="WindowResizeKeyboardAccelerator_OnInvoked" />
            <!--  Seek to percentage  -->
            <KeyboardAccelerator Key="NumberPad0" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad1" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad2" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad3" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad4" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad5" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad6" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad7" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad8" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="NumberPad9" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="Home" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <KeyboardAccelerator Key="End" Invoked="SeekToPercentageKeyboardAccelerator_OnInvoked" />
            <!--  Escape key handling  -->
            <KeyboardAccelerator
                Key="Escape"
                Invoked="EscapeKeyboardAccelerator_OnInvoked"
                IsEnabled="{x:Bind ViewModel.IsPlayerVisibilityVisible, Mode=OneWay}" />

        </Grid.KeyboardAccelerators>

        <Button
            x:Name="MiniPlayerTitleButton"
            Grid.Column="1"
            Margin="16,12,10,0"
            Padding="0"
            AutomationProperties.Name="{x:Bind ViewModel.Media.Name, Mode=OneWay, FallbackValue={}}"
            BorderThickness="0"
            Command="{x:Bind ViewModel.RestorePlayerCommand}"
            IsTabStop="False"
            Visibility="Collapsed">
            <Button.Resources>
                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            </Button.Resources>
            <StackPanel>
                <TextBlock
                    HorizontalAlignment="Left"
                    d:Text="Lorem ipsum dolor sit amet"
                    FontFamily="ms-appx:///Assets/Fonts/FuturaCyrillicMedium.ttf#Futura Cyrillic Medium"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Media.Name, Mode=OneWay, FallbackValue={}}"
                    TextWrapping="NoWrap" />

                <TextBlock
                    d:Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit"
                    FontFamily="ms-appx:///Assets/Fonts/FuturaCyrillicMedium.ttf#Futura Cyrillic Medium"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.Media.AltCaption, Mode=OneWay, FallbackValue={}}"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind ViewModel.Media.AltCaption, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}, FallbackValue=Collapsed}" />
            </StackPanel>
        </Button>

        <Grid
            x:Name="BackgroundElement"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            IsHitTestVisible="False"
            SizeChanged="BackgroundElementOnSizeChanged">
            <Grid
                x:Name="BackgroundArt"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="BackgroundArtTranslateTransform" />
                </Grid.RenderTransform>
                <Image
                    x:Name="BackgroundImageNext"
                    Source="{x:Bind AlbumArtImage.ImageSource, Mode=OneWay}"
                    Stretch="UniformToFill" />
                <Image x:Name="BackgroundImage" Stretch="UniformToFill">
                    <animations:Explicit.Animations>
                        <animations:AnimationSet x:Name="BackgroundArtFadeOutAnimation">
                            <animations:OpacityAnimation
                                EasingMode="EaseInOut"
                                To="0"
                                Duration="0:0:1" />
                        </animations:AnimationSet>
                        <animations:AnimationSet x:Name="BackgroundArtFadeInAnimation">
                            <animations:OpacityAnimation
                                EasingMode="EaseOut"
                                To="1"
                                Duration="0:0:1" />
                        </animations:AnimationSet>
                    </animations:Explicit.Animations>
                </Image>
            </Grid>

            <Border>
                <Border.Background>
                    <media:AcrylicBrush
                        x:Name="BackgroundAcrylicBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="{ThemeResource BackgroundAcrylicTintFallbackColor}"
                        TintColor="{ThemeResource BackgroundAcrylicTintColor}"
                        TintOpacity="{ThemeResource BackgroundAcrylicTintOpacity}" />
                </Border.Background>
            </Border>
        </Grid>

        <controls:PlayerElement
            x:Name="VideoView"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Black"
            ButtonMargin="0,52,0,84"
            Click="VideoView_OnClick"
            ContextFlyout="{x:Bind PlayerControls.PlayerContextMenu}"
            ManipulationCompleted="VideoView_OnManipulationCompleted">
            <interactivity:Interaction.Behaviors>
                <interactivity:EventTriggerBehavior EventName="DoubleTapped">
                    <interactivity:InvokeCommandAction Command="{x:Bind PlayerControls.ViewModel.ToggleFullscreenCommand}" />
                </interactivity:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </controls:PlayerElement>

        <Button
            x:Name="HiddenButton"
            Grid.Row="0"
            Grid.Column="0"
            Click="{x:Bind ViewModel.HiddenButtonOnClick}"
            Opacity="0"
            Style="{x:Null}"
            Visibility="Collapsed" />

        <ctc:ConstrainedBox
            x:Name="AlbumArtPanel"
            Grid.Row="1"
            Grid.Column="0"
            MinWidth="64"
            MaxWidth="300"
            Margin="32,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            AspectRatio="1:1"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Grid
                x:Name="AlbumArt"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                FlowDirection="LeftToRight">
                <Grid.Background>
                    <ImageBrush
                        x:Name="AlbumArtImage"
                        ImageSource="{x:Bind ViewModel.Media.Thumbnail, Mode=OneWay, FallbackValue={x:Null}}"
                        Stretch="UniformToFill" />
                </Grid.Background>
                <Border
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="{x:Bind AlbumArt.CornerRadius, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Media.Thumbnail, Mode=OneWay, Converter={StaticResource EmptyObjectToVisibilityConverter}, ConverterParameter=true, FallbackValue=Visible}">
                    <FontIcon
                        x:Name="AlbumArtGlyph"
                        FontSize="80"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.Media, Converter={StaticResource MediaGlyphConverter}, Mode=OneWay, FallbackValue=&#xEA69;}" />
                </Border>
            </Grid>
        </ctc:ConstrainedBox>

        <Button
            x:Name="RestorePlayerButton"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Padding="8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Top"
            AutomationProperties.Name="{strings:Resources Key=RestoreView}"
            Command="{x:Bind ViewModel.RestorePlayerCommand}"
            KeyTipPlacementMode="Center"
            Visibility="Collapsed">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemControlTransparentBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="I" />
            </Button.KeyboardAccelerators>
            <muxc:AnimatedIcon x:Name="RestorePlayerIcon" Width="20">
                <animatedVisuals:AnimatedChevronUpDownSmallVisualSource />
                <muxc:AnimatedIcon.FallbackIconSource>
                    <muxc:SymbolIconSource Symbol="Up" />
                </muxc:AnimatedIcon.FallbackIconSource>
            </muxc:AnimatedIcon>
            <ToolTipService.ToolTip>
                <ToolTip Content="{strings:Resources Key=RestoreView}" PlacementRect="0,6,162,90" />
            </ToolTipService.ToolTip>
        </Button>

        <Border
            x:Name="StatusMessage"
            Grid.Row="1"
            Grid.Column="0"
            Margin="24,8"
            Padding="9,5,9,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            animations:Implicit.HideAnimations="{StaticResource FadeOutImplicitAnimation}"
            animations:Implicit.ShowAnimations="{StaticResource FadeInImplicitAnimation}"
            d:Visibility="Visible"
            Background="{ThemeResource AcrylicInAppFillColorBaseBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorForStrongFillWhenOnImage}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}">
            <TextBlock
                x:Name="StatusMessageText"
                d:Text="Volume 100%"
                FontFamily="ms-appx:///Assets/Fonts/FuturaCyrillicMedium.ttf#Futura Cyrillic Medium"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </Border>

        <Border
            x:Name="PlayerStateBadgeContainer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            IsHitTestVisible="False">
            <Border
                x:Name="PlayerStateBadge"
                Width="88"
                Height="88"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                Background="{ThemeResource AcrylicInAppFillColorBaseBrush}"
                BorderThickness="0"
                CornerRadius="44">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="PlayerStateBadgeTransform" ScaleX="0.75" ScaleY="0.75" />
                </Border.RenderTransform>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!--  Play triangle path (solid white with smooth rounded corners)  -->
                    <Viewbox Width="30" Height="32" Margin="3,0,0,0">
                        <Path
                            x:Name="PlayerStateBadgePlayIcon"
                            Data="M 6,3.5 C 3.2,1.9 0,3.9 0,7.2 L 0,24.8 C 0,28.1 3.2,30.1 6,28.5 L 21.4,19.7 C 24.2,18.1 24.2,13.9 21.4,12.3 Z"
                            Fill="White"
                            Stretch="Fill"
                            Visibility="{x:Bind converters:GlyphConverter.ToPlayVisibility(ViewModel.IsPlayingBadge), Mode=OneWay}" />
                    </Viewbox>
                    <!--  Pause icon (two vertical bars with rounded pill corners)  -->
                    <Grid
                        x:Name="PlayerStateBadgePauseIcon"
                        Width="28"
                        Height="30"
                        Visibility="{x:Bind converters:GlyphConverter.ToPauseVisibility(ViewModel.IsPlayingBadge), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="10" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="White" RadiusX="4" RadiusY="4" />
                        <Rectangle Grid.Column="2" Fill="White" RadiusX="4" RadiusY="4" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <muxc:ProgressRing
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Width="64"
            Height="64"
            d:Visibility="Collapsed"
            IsActive="True"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.IsOpening, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <controls:NotificationView
            x:Name="NotificationView"
            Grid.Row="1"
            Grid.Column="0"
            Margin="12,0,12,-12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="4" />

        <Border
            x:Name="PlayerControlsBackground"
            Grid.Row="2"
            Grid.Column="0"
            Background="{ThemeResource PlayerControlsBackgroundBrush}"
            Tapped="PlayerControlsBackground_OnTapped">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PlayerControlsBackgroundTransform" />
            </Border.RenderTransform>
        </Border>

        <controls:PlayerControls
            x:Name="PlayerControls"
            Grid.Row="2"
            Grid.Column="0"
            Padding="12,4,12,16">
            <controls:PlayerControls.RenderTransform>
                <TranslateTransform x:Name="PlayerControlsTransform" />
            </controls:PlayerControls.RenderTransform>
        </controls:PlayerControls>

        <controls:TitleBar
            x:Name="PlayerTitleBar"
            MinHeight="80"
            Background="{ThemeResource PlayerTitleBarBackgroundBrush}">
            <controls:TitleBar.RenderTransform>
                <TranslateTransform x:Name="PlayerTitleBarTransform" />
            </controls:TitleBar.RenderTransform>
            <controls:TitleBar.Resources>
                <Thickness x:Key="TitleBarIconMargin">12,0,12,0</Thickness>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </controls:TitleBar.Resources>

            <Grid x:Name="PlayerTitleBarContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Width="44"
                    Height="44"
                    Margin="{StaticResource PlayerTitleBarButtonMargin}"
                    AutomationProperties.Name="{x:Bind strings:Resources.MinimizeImmersiveView}"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind strings:Resources.MinimizeImmersiveView}">
                    <FontIcon FontSize="16" Glyph="&#xEE49;" />
                </Button>

                <Button
                    x:Name="PlayQueueButton"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Width="44"
                    Height="44"
                    Margin="{StaticResource PlayerTitleBarButtonMargin}"
                    Padding="0"
                    AllowDrop="True"
                    AutomationProperties.Name="{x:Bind strings:Resources.PlayQueue}"
                    Click="PlayQueueButton_OnClick"
                    DragEnter="PlayQueueButton_OnDragEnter"
                    DragLeave="PlayQueueButton_OnDragLeave"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind strings:Resources.PlayQueue}">
                    <FontIcon
                        x:Name="PlayQueueButtonIcon"
                        FontFamily="{StaticResource OdeonSymbolThemeFontFamily}"
                FontSize="32"
                        Glyph="{StaticResource PlaylistMusicGlyph}" />
                </Button>

                <TextBlock
                    x:Name="TitleBarTitleTextBlock"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="36,12,16,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontFamily="ms-appx:///Assets/Fonts/FuturaCyrillicMedium.ttf#Futura Cyrillic Medium"
                    FontWeight="Medium"
                    FontSize="26"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    IsHitTestVisible="False"
                    Text="{x:Bind ViewModel.Media.Name, Mode=OneWay, FallbackValue={}}"
                    TextAlignment="Left"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </controls:TitleBar>
    </Grid>

    <!-- Subtitle Side Panel Backdrop (transparent hit-target to dismiss when tapping outside, without dimming the video) -->
    <Rectangle
        x:Name="SubtitlePanelBackdrop"
        Canvas.ZIndex="99"
        Fill="Transparent"
        Opacity="0"
        IsHitTestVisible="False"
        Tapped="SubtitlePanelBackdrop_OnTapped" />

    <!-- Subtitle Side Panel (floating directly above subtitle toggle) -->
    <controls:SubtitleSidePanel
        x:Name="SubtitleSidePanel"
        Canvas.ZIndex="100"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,24,56"
        Width="380"
        MaxHeight="700"
        Visibility="Collapsed"
        PlayerControlsViewModel="{x:Bind PlayerControls.ViewModel, Mode=OneWay}">
        <controls:SubtitleSidePanel.RenderTransform>
            <TranslateTransform x:Name="SubtitlePanelTransform" X="440" />
        </controls:SubtitleSidePanel.RenderTransform>
    </controls:SubtitleSidePanel>

    <!-- Audio Side Panel (floating directly above audio toggle) -->
    <controls:AudioSidePanel
        x:Name="AudioSidePanel"
        Canvas.ZIndex="100"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,24,56"
        Width="380"
        MaxHeight="700"
        Visibility="Collapsed"
        PlayerControlsViewModel="{x:Bind PlayerControls.ViewModel, Mode=OneWay}">
        <controls:AudioSidePanel.RenderTransform>
            <TranslateTransform x:Name="AudioPanelTransform" X="440" />
        </controls:AudioSidePanel.RenderTransform>
    </controls:AudioSidePanel>

    <!-- Play Queue Side Panel (floating directly above play queue toggle, same as audio/subtitle) -->
    <controls:PlayQueueSidePanel
        x:Name="PlayQueueSidePanel"
        Canvas.ZIndex="100"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,24,56"
        Width="480"
        MaxHeight="750"
        Visibility="Collapsed">
        <controls:PlayQueueSidePanel.RenderTransform>
            <TranslateTransform x:Name="PlayQueuePanelTransform" X="540" />
        </controls:PlayQueueSidePanel.RenderTransform>
    </controls:PlayQueueSidePanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ControlsVisibilityStates" CurrentStateChanged="ControlsVisibilityStates_OnCurrentStateChanged">
                <VisualState x:Name="ControlsVisible">
                    <VisualState.Setters>
                        <Setter Target="PlayerTitleBarTransform.Y" Value="0" />
                        <Setter Target="PlayerControlsTransform.Y" Value="0" />
                        <Setter Target="PlayerControlsBackgroundTransform.Y" Value="0" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ControlsHidden">
                    <VisualState.Setters>
                        <Setter Target="PlayerTitleBar.Opacity" Value="0" />
                        <Setter Target="HiddenButton.Visibility" Value="Visible" />
                        <Setter Target="PlayerControls.Opacity" Value="0" />
                        <Setter Target="PlayerControlsBackground.Opacity" Value="0" />
                        <Setter Target="PlayerTitleBarTransform.Y" Value="-100" />
                        <Setter Target="PlayerControlsTransform.Y" Value="150" />
                        <Setter Target="PlayerControlsBackgroundTransform.Y" Value="150" />
                    </VisualState.Setters>
                </VisualState>

                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.35" To="ControlsVisible">
                        <VisualTransition.GeneratedEasingFunction>
                            <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                    <VisualTransition GeneratedDuration="0:0:0.28" To="ControlsHidden">
                        <VisualTransition.GeneratedEasingFunction>
                            <BackEase Amplitude="0.2" EasingMode="EaseIn" />
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ContentStates">
                <VisualState x:Name="Video">
                    <VisualState.Setters>
                        <!--<Setter Target="LivelyOptionsButton.Visibility" Value="Collapsed" />-->
                        <Setter Target="BackgroundElement.Visibility" Value="Collapsed" />
                        <Setter Target="VideoView.Opacity" Value="1" />
                        <Setter Target="AlbumArtPanel.Visibility" Value="Collapsed" />
                        <Setter Target="PlayerControlsBackground.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="AudioOnly">
                    <VisualState.Setters>
                        <Setter Target="PlayerTitleBar.Background" Value="Transparent" />
                        <Setter Target="BackgroundElement.Visibility" Value="Visible" />
                        <Setter Target="VideoView.Opacity" Value="0" />
                        <Setter Target="AlbumArtPanel.Visibility" Value="Visible" />
                        <Setter Target="PlayerControlsBackground.Opacity" Value="0" />
                    </VisualState.Setters>
                    <Storyboard x:Name="BackgroundArtAnimation">
                        <DoubleAnimationUsingKeyFrames
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="BackgroundArtTranslateTransform"
                            Storyboard.TargetProperty="X">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-100" />
                            <EasingDoubleKeyFrame KeyTime="0:0:30" Value="100">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <DiscreteDoubleKeyFrame KeyTime="0:1:00" Value="100" />
                            <EasingDoubleKeyFrame KeyTime="0:1:30" Value="-100">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <DiscreteDoubleKeyFrame KeyTime="0:2:00" Value="-100" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames
                            BeginTime="0:0:30"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="BackgroundArtTranslateTransform"
                            Storyboard.TargetProperty="Y">
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-100" />
                            <EasingDoubleKeyFrame KeyTime="0:0:30" Value="100">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <DiscreteDoubleKeyFrame KeyTime="0:1:00" Value="100" />
                            <EasingDoubleKeyFrame KeyTime="0:1:30" Value="-100">
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <QuadraticEase EasingMode="EaseInOut" />
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                            <DiscreteDoubleKeyFrame KeyTime="0:2:00" Value="-100" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>


                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.5" To="Video">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AlbumArtPanel" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VideoView" Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation
                                Storyboard.TargetName="BackgroundAcrylicBrush"
                                Storyboard.TargetProperty="TintOpacity"
                                To="1"
                                Duration="0:0:0.2" />
                            <ColorAnimation
                                Storyboard.TargetName="BackgroundAcrylicBrush"
                                Storyboard.TargetProperty="TintColor"
                                To="#202020"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </VisualTransition>

                    <VisualTransition GeneratedDuration="0:0:0.24" To="AudioOnly">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AlbumArtPanel" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundElement" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                            </ObjectAnimationUsingKeyFrames>

                            <RepositionThemeAnimation FromVerticalOffset="200" TargetName="AlbumArtPanel" />
                        </Storyboard>
                    </VisualTransition>

                </VisualStateGroup.Transitions>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PreviewWindowGroup">
                <VisualState x:Name="NoPreview" />

                <VisualState x:Name="VideoPreview">
                    <VisualState.Setters>
                        <Setter Target="FirstColumn.Width" Value="160" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="AudioPreview">
                    <VisualState.Setters>
                        <Setter Target="FirstColumn.Width" Value="109" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="LayoutGroup" CurrentStateChanged="OnLayoutVisualStateChanged">
                <VisualState x:Name="Normal" />

                <VisualState x:Name="Fullscreen">
                    <VisualState.Setters>
                        <Setter Target="PlayerTitleBar.MinHeight" Value="128" />
                        <Setter Target="BackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PlayQueueButton.Margin" Value="20,-40,0,2" />
                        <Setter Target="VideoView.ButtonMargin" Value="0,80,0,112" />
                        <Setter Target="PlayerControls.Padding" Value="16,8,16,20" />
                        <Setter Target="SubtitleSidePanel.Margin" Value="0,0,24,60" />
                        <Setter Target="AudioSidePanel.Margin" Value="0,0,24,60" />
                        <Setter Target="PlayQueueSidePanel.Margin" Value="0,0,24,60" />
                    </VisualState.Setters>
                    <Storyboard>
                        <RepositionThemeAnimation
                            FromVerticalOffset="-24"
                            TargetName="PlayerTitleBarContentGrid" />
                        <RepositionThemeAnimation
                            FromVerticalOffset="96"
                            TargetName="AlbumArtPanel" />
                        <RepositionThemeAnimation FromVerticalOffset="96" TargetName="PlayerControls" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="CompactOverlay">
                    <VisualState.Setters>
                        <Setter Target="PlayerTitleBar.MinHeight" Value="32" />
                        <Setter Target="PlayerTitleBar.Icon" Value="{ui:BitmapIcon Source=ms-appx:///Assets/Square44x44Logo.png, ShowAsMonochrome=False}" />
                        <Setter Target="BackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PlayQueueButton.Visibility" Value="Collapsed" />
                        <!--<Setter Target="LivelyOptionsButton.Visibility" Value="Collapsed" />-->
                        <Setter Target="AlbumArtPanel.HorizontalAlignment" Value="Center" />
                        <Setter Target="AlbumArtPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="AlbumArtPanel.Margin" Value="16,12" />
                        <Setter Target="VideoView.ButtonMargin" Value="0,0,0,40" />
                        <Setter Target="StatusMessage.Margin" Value="12,4" />
                        <Setter Target="StatusMessage.Padding" Value="5,2,5,3" />
                        <Setter Target="StatusMessageText.FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
                        <Setter Target="NotificationView.Margin" Value="4" />
                        <Setter Target="PlayerControls.Padding" Value="0,4,0,0" />
                    </VisualState.Setters>
                    <Storyboard>
                        <RepositionThemeAnimation FromHorizontalOffset="-96" TargetName="PlayerTitleBar" />
                        <RepositionThemeAnimation
                            FromHorizontalOffset="-48"
                            FromVerticalOffset="48"
                            TargetName="AlbumArtPanel" />
                        <RepositionThemeAnimation FromVerticalOffset="48" TargetName="PlayerControls" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="MiniPlayer">
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                        <Setter Target="LayoutRoot.CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                        <Setter Target="LayoutRoot.Height" Value="128" />
                        <Setter Target="LayoutRoot.Padding" Value="8,8,8,8" />
                        <Setter Target="LayoutRoot.VerticalAlignment" Value="Bottom" />
                        <Setter Target="SecondColumn.Width" Value="*" />
                        <Setter Target="PlayerTitleBar.Visibility" Value="Collapsed" />
                        <Setter Target="MiniPlayerTitleButton.Visibility" Value="Visible" />
                        <Setter Target="BackgroundElement.Opacity" Value="0" />
                        <Setter Target="VideoView.CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                        <Setter Target="VideoView.IsEnabled" Value="False" />
                        <Setter Target="AlbumArtPanel.(Grid.Row)" Value="0" />
                        <Setter Target="AlbumArtPanel.(Grid.RowSpan)" Value="3" />
                        <Setter Target="AlbumArtPanel.Margin" Value="0" />
                        <Setter Target="AlbumArtGlyph.FontSize" Value="32" />
                        <Setter Target="AlbumArt.BorderThickness" Value="0" />
                        <Setter Target="AlbumArt.CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                        <Setter Target="RestorePlayerButton.Visibility" Value="Visible" />
                        <Setter Target="RestorePlayerIcon.Visibility" Value="Collapsed" />
                        <Setter Target="StatusMessage.Visibility" Value="Collapsed" />
                        <Setter Target="NotificationView.Visibility" Value="Collapsed" />
                        <Setter Target="PlayerControlsBackground.Visibility" Value="Collapsed" />
                        <Setter Target="PlayerControls.(Grid.Column)" Value="1" />
                        <Setter Target="PlayerControls.Margin" Value="6,0,0,0" />
                        <Setter Target="PlayerControls.Padding" Value="0" />
                        <Setter Target="PlayerControls.VerticalAlignment" Value="Center" />
                        <Setter Target="SubtitleSidePanel.Margin" Value="0,0,24,136" />
                        <Setter Target="AudioSidePanel.Margin" Value="0,0,24,136" />
                        <Setter Target="PlayerStateBadgeContainer.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Hidden">
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                        <Setter Target="LayoutRoot.CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                        <Setter Target="LayoutRoot.Height" Value="0" />
                        <Setter Target="LayoutRoot.Padding" Value="8,8,8,8" />
                        <Setter Target="LayoutRoot.VerticalAlignment" Value="Bottom" />
                        <Setter Target="SecondColumn.Width" Value="*" />
                        <Setter Target="PlayerTitleBar.Visibility" Value="Collapsed" />
                        <Setter Target="MiniPlayerTitleButton.Visibility" Value="Collapsed" />
                        <Setter Target="BackgroundElement.Opacity" Value="0" />
                        <Setter Target="VideoView.IsEnabled" Value="False" />
                        <Setter Target="AlbumArtPanel.(Grid.Row)" Value="0" />
                        <Setter Target="AlbumArtPanel.(Grid.RowSpan)" Value="3" />
                        <Setter Target="AlbumArtPanel.Margin" Value="0" />
                        <Setter Target="AlbumArtPanel.Opacity" Value="0" />
                        <Setter Target="StatusMessage.Visibility" Value="Collapsed" />
                        <Setter Target="NotificationView.Visibility" Value="Collapsed" />
                        <Setter Target="PlayerControlsBackground.Visibility" Value="Collapsed" />
                        <Setter Target="PlayerControls.(Grid.Column)" Value="1" />
                        <Setter Target="PlayerControls.IsEnabled" Value="False" />
                        <Setter Target="PlayerControls.Padding" Value="0" />
                        <Setter Target="PlayerControls.Margin" Value="6,0,0,0" />
                        <Setter Target="PlayerControls.VerticalAlignment" Value="Center" />
                    </VisualState.Setters>
                    <Storyboard>
                        <FadeOutThemeAnimation TargetName="LayoutRoot" />
                    </Storyboard>
                </VisualState>

                <VisualStateGroup.Transitions>
                    <VisualTransition From="Fullscreen" To="Normal">
                        <Storyboard>
                            <RepositionThemeAnimation
                                FromVerticalOffset="24"
                                TargetName="PlayerTitleBarContentGrid" />
                            <RepositionThemeAnimation
                                FromVerticalOffset="-40"
                                TargetName="AlbumArtPanel" />
                            <RepositionThemeAnimation FromVerticalOffset="-40" TargetName="PlayerControls" />
                        </Storyboard>
                    </VisualTransition>

                    <VisualTransition From="CompactOverlay" To="Normal">
                        <Storyboard>
                            <RepositionThemeAnimation FromHorizontalOffset="256" TargetName="PlayerTitleBar" />
                            <RepositionThemeAnimation
                                FromHorizontalOffset="256"
                                FromVerticalOffset="-256"
                                TargetName="AlbumArtPanel" />
                            <RepositionThemeAnimation FromVerticalOffset="-80" TargetName="PlayerControls" />
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
            </VisualStateGroup>

            <VisualStateGroup x:Name="MiniPlayerMarginGroup">
                <VisualState x:Name="NoMargin" />
                <VisualState x:Name="NormalMargin">
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Margin" Value="12,0,12,10" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MinimalMargin">
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Margin" Value="8,0,8,6" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HiddenMinimalMargin">
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Margin" Value="8,0,8,-1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HiddenNormalMargin">
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Margin" Value="12,0,12,-1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="WindowActivationGroup">
                <VisualState x:Name="Deactivated">
                    <VisualState.StateTriggers>
                        <triggers:WindowActivationModeTrigger ActivationMode="Deactivated" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BackButton.Opacity" Value="{ThemeResource TextFillColorTertiaryOpacity}" />
                        <Setter Target="PlayQueueButton.Opacity" Value="{ThemeResource TextFillColorTertiaryOpacity}" />
                        <Setter Target="TitleBarTitleTextBlock.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="FlowDirectionStates">
                <VisualState x:Name="LeftToRight" />

                <VisualState x:Name="RightToLeft">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind helpers:GlobalizationHelper.IsRightToLeftLanguage}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlayQueueButtonIcon.Glyph" Value="{StaticResource FolderListMirroredGlyph}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
