<UserControl
    x:Class="Odeon.Controls.SubtitleSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Odeon.Behaviors"
    xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:strings="using:Odeon.Strings"
    xmlns:system="using:System"
    mc:Ignorable="d"
    UseLayoutRounding="True"
    FontFamily="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Progress.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular</FontFamily>
            <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular</FontFamily>
            <ctConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <media:AcrylicBrush
                        x:Key="SidePanelBackgroundBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="#1E1E1E"
                        TintColor="#141414"
                        TintOpacity="0.88" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <media:AcrylicBrush
                        x:Key="SidePanelBackgroundBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="#F4F4F4"
                        TintColor="#FAFAFA"
                        TintOpacity="0.88" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#22000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SidePanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource SidePanelBackgroundBrush}"
        BorderThickness="0"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Subtitle Track List (compact, exactly 4 visible at a time, scrollable for more) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Divider -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Subtitle Controls -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="18,14,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{strings:Resources Key=Subtitles}"
                    FontWeight="SemiBold"
                    FontSize="18"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.AddSubtitleCommand}"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{strings:Resources Key=AddSubtitle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            Margin="{StaticResource IconButtonStandardIconMargin}"
                            FontSize="12"
                            Glyph="&#xE710;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            Text="{strings:Resources Key=AddSubtitle}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    x:Name="CloseButton"
                    Click="CloseButton_OnClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="0"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ListView
                x:Name="SubtitleTrackListView"
                Grid.Row="1"
                ItemsSource="{x:Bind SubtitleDisplayList}"
                SelectionChanged="SubtitleTrackListView_OnSelectionChanged"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False"
                MaxHeight="144"
                Padding="0"
                ContainerContentChanging="SubtitleTrackListView_OnContainerContentChanging"
                PointerExited="SubtitleTrackListView_OnPointerExited"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                Margin="8,4,8,6"
                ItemContainerStyle="{StaticResource SidePanelTrackItemStyle}"
                ItemContainerTransitions="{x:Null}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="system:String">
                        <TextBlock
                            Text="{x:Bind}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Divider -->
            <Rectangle
                Grid.Row="2"
                Height="1"
                Fill="{ThemeResource SidePanelBorderBrush}"
                Margin="16,2,16,10" />

            <!-- Bottom: Subtitle Controls (clean flat layout, comfortable spacing) -->
            <Grid Grid.Row="3" Padding="18,0,18,24">
                <!-- DataContext is assigned from code-behind (see ApplySettingsDataContext): the
                     section binds to PlayerControlsViewModel while the panel itself is bound to
                     CompositeTrackPickerViewModel for the track list. -->
                <StackPanel
                    x:Name="SettingsSection"
                    Orientation="Vertical"
                    Spacing="8">

                    <!-- Background box toggle -->
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Background box"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            Margin="0,0,12,0" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            Margin="0"
                            AutomationProperties.HelpText="Displays a rectangular background box behind subtitles."
                            IsOn="{Binding SubtitleBackgroundEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- Box opacity slider -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Box opacity" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.8">
                            <Run Text="{Binding ElementName=SubtitleBackgroundOpacitySlider, Path=Value, FallbackValue=75}" /> <Run Text="%" />
                        </TextBlock>
                    </Grid>
                    <Slider
                        x:Name="SubtitleBackgroundOpacitySlider"
                        Style="{StaticResource SidePanelSliderStyle}"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="10"
                        SmallChange="5"
                        StepFrequency="5"
                        Margin="0,2,0,2"
                        Padding="0"
                        AutomationProperties.HelpText="Adjusts subtitle background box opacity."
                        Value="{Binding SubtitleBackgroundOpacity, Mode=TwoWay}" />

                    <!-- Timing offset slider -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{strings:Resources Key=TimingOffset}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.8">
                            <Run Text="{Binding ElementName=SubtitleTimingOffsetSlider, Path=Value, FallbackValue=0}" /> <Run Text="ms" />
                        </TextBlock>
                    </Grid>
                    <Slider
                        x:Name="SubtitleTimingOffsetSlider"
                        Style="{StaticResource SidePanelSliderStyle}"
                        IsThumbToolTipEnabled="False"
                        Maximum="3000"
                        Minimum="-3000"
                        SmallChange="25"
                        StepFrequency="50"
                        Margin="0,2,0,2"
                        Padding="0"
                        Value="{Binding SubtitleTimingOffset, Mode=TwoWay}" />

                    <!-- Font size slider -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font size" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.8">
                            <Run Text="{Binding ElementName=SubtitleFontSizeSlider, Path=Value, FallbackValue=50}" /> <Run Text="pt" />
                        </TextBlock>
                    </Grid>
                    <Slider
                        x:Name="SubtitleFontSizeSlider"
                        Style="{StaticResource SidePanelSliderStyle}"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="16"
                        SmallChange="1"
                        StepFrequency="2"
                        Margin="0,2,0,2"
                        Padding="0"
                        AutomationProperties.HelpText="Adjusts subtitle font size directly."
                        Value="{Binding SubtitleFontSize, Mode=TwoWay}" />

                    <!-- Position offset slider -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Position" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding SubtitlePositionDisplay, Mode=OneWay, FallbackValue=Default}" />
                            <Button
                                ToolTipService.ToolTip="Reset position"
                                AutomationProperties.Name="Reset subtitle position"
                                Command="{Binding ResetSubtitlePositionCommand}"
                                Padding="6,3"
                                VerticalAlignment="Center">
                                <FontIcon FontSize="11" Glyph="&#xE777;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Slider
                        x:Name="SubtitlePositionSlider"
                        Style="{StaticResource SidePanelSliderStyle}"
                        IsThumbToolTipEnabled="False"
                        Maximum="50"
                        Minimum="-15"
                        SmallChange="1"
                        StepFrequency="1"
                        Margin="0,2,0,2"
                        Padding="0"
                        AutomationProperties.HelpText="Adjusts subtitle vertical position."
                        Value="{Binding SubtitlePositionOffset, Mode=TwoWay}" />

                    <!-- Subtitle outline toggle -->
                    <Grid HorizontalAlignment="Stretch" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Subtitle outline"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            Margin="0,0,12,0" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            Margin="0"
                            AutomationProperties.HelpText="Enables or disables the text outline stroke around subtitles."
                            IsOn="{Binding SubtitleOutlineEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- Override subtitle styles toggle -->
                    <Grid HorizontalAlignment="Stretch" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Override subtitle styles"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            Margin="0,0,12,0" />
                        <ToggleSwitch
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            Margin="0"
                            AutomationProperties.HelpText="Forces the application's font and color settings on ASS/SSA subtitle files, ignoring their embedded styles."
                            IsOn="{Binding OverrideSubtitleStyles, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
