<UserControl
    x:Name="Root"
    x:Class="Odeon.Controls.ChapterProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Odeon.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:Odeon.Core.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="400"
    UseLayoutRounding="True"
    FontFamily="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Progress.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ProgressBarBackground" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FFE81123" />

            <DataTemplate x:Key="ItemTemplate" x:DataType="viewModels:ChapterViewModel">
                <Grid
                    Width="{x:Bind Width, Mode=OneWay}"
                    Height="{x:Bind Height, Mode=OneWay}"
                    VerticalAlignment="Center"
                    CornerRadius="3">
                    <Rectangle
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        RadiusX="3"
                        RadiusY="3"
                        Fill="{ThemeResource ProgressBarBackground}" />
                    <Rectangle
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Width="{x:Bind FillWidth, Mode=OneWay}"
                        RadiusX="3"
                        RadiusY="3"
                        Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                </Grid>
            </DataTemplate>

            <muxc:StackLayout
                x:Key="HorizontalStackLayout"
                Orientation="Horizontal"
                Spacing="3" />
        </ResourceDictionary>
    </UserControl.Resources>

    <muxc:ItemsRepeater
        x:Name="ChaptersRepeater"
        ItemTemplate="{StaticResource ItemTemplate}"
        ItemsSource="{x:Bind ProgressItems}"
        Layout="{StaticResource HorizontalStackLayout}" />
</UserControl>
