<UserControl
    x:Class="Odeon.Controls.ChapterProgressBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Odeon.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:Odeon.Core.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Progress.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <muxc:ProgressBar
        Maximum="{x:Bind Maximum, Mode=OneWay}"
        Minimum="0"
        Value="{x:Bind Value, Mode=OneWay}"
        MinHeight="{x:Bind MinHeight, Mode=OneWay}"
        Style="{StaticResource NoAnimationProgressBarStyle}"
        Padding="0"
        BorderThickness="0"
        Foreground="Red">
        <muxc:ProgressBar.Resources>
            <CornerRadius x:Key="ProgressBarCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ProgressBarTrackCornerRadius">0</CornerRadius>
        </muxc:ProgressBar.Resources>
    </muxc:ProgressBar>
</UserControl>
