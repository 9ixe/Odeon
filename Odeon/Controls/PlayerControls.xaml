<UserControl
    x:Class="Odeon.Controls.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="using:Odeon.Commands"
    xmlns:controls="using:Odeon.Controls"
    xmlns:converters="using:Odeon.Converters"
    xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Odeon.Extensions"
    xmlns:helpers="using:Odeon.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:strings="using:Odeon.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    d:DesignHeight="128"
    d:DesignWidth="1200"
    UseLayoutRounding="True"
    mc:Ignorable="d"
    FontFamily="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Flyout.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Progress.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:ToggleButtonCheckToRepeatModeConverter x:Key="ToggleButtonCheckToRepeatModeConverter" />

            <Thickness x:Key="MenuFlyoutItemThemePadding">10,6,12,6</Thickness>
            <Thickness x:Key="MenuFlyoutSubItemThemePadding">10,6,12,6</Thickness>
            <Thickness x:Key="ToggleMenuFlyoutItemThemePadding">10,6,12,6</Thickness>

            <x:Double x:Key="Speed025">0.25</x:Double>
            <x:Double x:Key="Speed050">0.5</x:Double>
            <x:Double x:Key="Speed075">0.75</x:Double>
            <x:Double x:Key="Speed100">1.0</x:Double>
            <x:Double x:Key="Speed125">1.25</x:Double>
            <x:Double x:Key="Speed150">1.5</x:Double>
            <x:Double x:Key="Speed175">1.75</x:Double>
            <x:Double x:Key="Speed200">2.0</x:Double>
            <x:Double x:Key="Speed400">4.0</x:Double>

            <Flyout x:Key="VolumeControlFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="6,7,6,9" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <controls:VolumeControl
                    Width="212"
                    IsAccessKeyScope="True"
                    VolumeToggleButtonStyle="{StaticResource SmallPlayerToggleButtonStyle}" />
            </Flyout>

            <Flyout x:Key="CustomPlaybackSpeedFlyout" ShouldConstrainToRootBounds="True">
                <StackPanel
                    Width="180"
                    Orientation="Vertical"
                    Spacing="8">
                    <Slider
                        x:Name="SpeedSlider"
                        Style="{StaticResource PlayerSliderStyle}"
                        Header="{strings:Resources Key=CustomPlaybackSpeed}"
                        IsThumbToolTipEnabled="False"
                        Maximum="2"
                        Minimum="0"
                        SmallChange="0.01"
                        StepFrequency="0.05"
                        ValueChanged="SpeedSlider_OnValueChanged"
                        Value="1.0" />
                    <TextBlock HorizontalAlignment="Center"><Run Text="{Binding ElementName=SpeedSlider, Path=Value, FallbackValue=1.0}" /> <Run Text="x" /></TextBlock>
                </StackPanel>
            </Flyout>

            <Flyout x:Key="CustomAspectRatioFlyout" ShouldConstrainToRootBounds="True">
                <StackPanel Width="180" Orientation="Vertical">
                    <TextBox
                        x:Name="AspectRatioTextBox"
                        AutomationProperties.Name="Custom aspect ratio TextBox"
                        Header="{strings:Resources Key=CustomAspectRatio}"
                        PlaceholderText="16:9"
                        TextChanged="AspectRatioTextBox_OnTextChanged" />
                </StackPanel>
            </Flyout>

            <Flyout x:Key="AudioOptionsFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel
                    Width="320"
                    FlowDirection="LeftToRight"
                    Orientation="Vertical"
                    Spacing="8">
                    <Slider
                        x:Name="AudioTimingOffsetSlider"
                        Style="{StaticResource PlayerSliderStyle}"
                        Header="{strings:Resources Key=TimingOffset}"
                        IsThumbToolTipEnabled="False"
                        Maximum="3000"
                        Minimum="-3000"
                        SmallChange="25"
                        StepFrequency="50"
                        Value="{Binding AudioTimingOffset, Mode=TwoWay}" />
                    <TextBlock HorizontalAlignment="Center"><Run Text="{Binding ElementName=AudioTimingOffsetSlider, Path=Value, FallbackValue=0}" /> <Run Text="ms" /></TextBlock>
                </StackPanel>
            </Flyout>

            <MenuFlyout x:Key="NormalPlayerContextMenu">
                <MenuFlyout.MenuFlyoutPresenterStyle>
                    <Style TargetType="MenuFlyoutPresenter">
                        <Setter Property="Padding" Value="0,4,0,4" />
                    </Style>
                </MenuFlyout.MenuFlyoutPresenterStyle>
                <MenuFlyoutItem
                    AccessKey="{strings:KeyboardResources Key=MenuItemPropertiesKey}"
                    Command="{StaticResource ShowPropertiesCommand}"
                    CommandParameter="{x:Bind ViewModel.PlayQueue.CurrentItem, Mode=OneWay}"
                    Icon="{ui:FontIcon Glyph=&#xE946;}"
                    IsEnabled="{x:Bind ViewModel.HasActiveItem, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Tab"
                    Text="{x:Bind strings:Resources.Properties}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem
                    x:Name="PlaybackSpeedSubMenu"
                    AccessKey="{strings:KeyboardResources Key=MenuItemSpeedKey}"
                    KeyTipPlacementMode="Left"
                    Text="{x:Bind strings:Resources.PlaybackSpeed}">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon FontFamily="{StaticResource OdeonSymbolThemeFontFamily}" Glyph="{x:Bind converters:GlyphConverter.ToSpeedGlyph(ViewModel.PlaybackRate), Mode=OneWay}" />
                    </MenuFlyoutSubItem.Icon>
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed025MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed025MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed025}"
                        Text="0.25x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed05MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed05MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed050}"
                        Text="0.5x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed075MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed075MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed075}"
                        Text="0.75x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed1MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed1MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        IsChecked="True"
                        Tag="{StaticResource Speed100}"
                        Text="1x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed125MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed125MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed125}"
                        Text="1.25x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed15MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed15MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed150}"
                        Text="1.5x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed175MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed175MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed175}"
                        Text="1.75x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed2MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed2MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed200}"
                        Text="2x" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="PlaybackSpeed4MenuItem"
                        Command="{x:Bind ViewModel.SetPlaybackRateCommand}"
                        CommandParameter="{x:Bind PlaybackSpeed4MenuItem.Tag}"
                        GroupName="SpeedGroup"
                        Tag="{StaticResource Speed400}"
                        Text="4x" />
                    <MenuFlyoutSeparator />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="CustomPlaybackSpeedMenuItem"
                        Click="CustomSpeedMenuItem_OnClick"
                        GroupName="SpeedGroup"
                        Text="{strings:Resources Key=Custom}" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    AccessKey="{strings:KeyboardResources Key=MenuItemSaveSnapshotKey}"
                    Command="{x:Bind ViewModel.SaveSnapshotCommand}"
                    Icon="{ui:FontIcon FontFamily={StaticResource OdeonSymbolThemeFontFamily},
                                       Glyph={StaticResource ImageExportGlyph}}"
                    Text="{x:Bind strings:Resources.SaveCurrentFrame}"
                    Visibility="{x:Bind helpers:DeviceInfoHelper.IsDesktop}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem
                    x:Name="AspectRatioSubMenu"
                    AccessKey="{strings:KeyboardResources Key=MenuItemAspectRatioKey}"
                    Icon="{ui:FontIcon Glyph=&#xE799;}"
                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                    Text="{strings:Resources Key=AspectRatio}">
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="Fit"
                        GroupName="AspectRatioGroup"
                        IsChecked="True"
                        Tag="0:0"
                        Text="{strings:Resources Key=Fit}" />
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="Fill"
                        GroupName="AspectRatioGroup"
                        Text="{strings:Resources Key=Fill}" />
                    <MenuFlyoutSeparator />
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="16:9"
                        GroupName="AspectRatioGroup"
                        Tag="16:9"
                        Text="16:9" />
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="4:3"
                        GroupName="AspectRatioGroup"
                        Tag="4:3"
                        Text="4:3" />
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="21:9"
                        GroupName="AspectRatioGroup"
                        Tag="21:9"
                        Text="21:9" />
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="1.85:1"
                        GroupName="AspectRatioGroup"
                        Tag="1.85:1"
                        Text="1.85:1" />
                    <muxc:RadioMenuFlyoutItem
                        Command="{x:Bind ViewModel.SetAspectRatioCommand}"
                        CommandParameter="1:1"
                        GroupName="AspectRatioGroup"
                        Tag="1:1"
                        Text="1:1" />
                    <muxc:RadioMenuFlyoutItem
                        x:Name="CustomAspectRatioMenuItem"
                        Click="CustomAspectRatioMenuItem_OnClick"
                        GroupName="AspectRatioGroup"
                        Text="{strings:Resources Key=Custom}" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="ShowChaptersMenuItem"
                    Command="{x:Bind ViewModel.ToggleShowChaptersCommand}"
                    Text="{x:Bind converters:GlyphConverter.ToChaptersText(ViewModel.PlayerShowChapters), Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE75B;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.GoBackToMiniplayerCommand}"
                    Icon="{ui:FontIcon Glyph=&#xE8A1;}"
                    Text="{strings:Resources Key=MinimizeImmersiveView}" />

                <MenuFlyoutItem
                    x:Name="FullscreenMenuItem"
                    AccessKey="{strings:KeyboardResources Key=MenuItemFullscreenKey}"
                    Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                    Icon="{ui:FontIcon Glyph=&#xE740;}"
                    Text="{x:Bind strings:Resources.FullscreenToggle(ViewModel.IsFullscreen), Mode=OneWay}"
                    Visibility="Collapsed">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            x:Name="FullscreenMenuItemKeyboardAccelerator"
                            IsEnabled="False" />
                        <KeyboardAccelerator Key="F11" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuFlyout>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Padding="{x:Bind Padding, Mode=OneWay}"
        Background="{x:Bind Background, Mode=OneWay}"
        BackgroundTransition="{x:Bind BackgroundTransition, Mode=OneWay}"
        KeyTipPlacementMode="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!--  Seek  -->
        <controls:SeekBar
            x:Name="SeekBar"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="12,-4,12,6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
            <!--  Offset used to lift the seek bar in fullscreen. It is set by the code-behind as a fraction of the window height, so that it stays visually the same on any display size, and it is a transform rather than a margin so that the control rows below keep their layout.  -->
            <controls:SeekBar.RenderTransform>
                <TranslateTransform x:Name="SeekBarOffset" />
            </controls:SeekBar.RenderTransform>
        </controls:SeekBar>
        <!--  Primary Panel  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Orientation="Horizontal">
            <!--  Play/Pause  -->
            <Button
                x:Name="PlayPauseButton"
                Margin="0,0,12,0"
                extensions:AcceleratorService.ToolTip="{x:Bind ViewModel.IsPlaying, Converter={StaticResource BoolToPlayPauseTextConverter}, Mode=OneWay}"
                AccessKey="{strings:KeyboardResources Key=PlayerPlayPauseKey}"
                AutomationProperties.Name="{x:Bind PlayPauseButton.(extensions:AcceleratorService.ToolTip), Mode=OneWay}"
                Command="{x:Bind ViewModel.PlayPauseCommand}"
                Style="{StaticResource RoundedFluentPlayerButtonStyle}">
                <Grid>
                    <FontIcon
                        FontFamily="{StaticResource OdeonSymbolThemeFontFamily}"
                        FontSize="18"
                        Glyph="&#xE768;"
                        Visibility="{x:Bind ViewModel.IsPlaying, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true, Mode=OneWay}" />
                    <FontIcon
                        FontFamily="{StaticResource OdeonSymbolThemeFontFamily}"
                        FontSize="18"
                        Glyph="&#xE769;"
                        Visibility="{x:Bind ViewModel.IsPlaying, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="P" Invoked="PlayPauseKeyboardAccelerator_OnInvoked" />
                    <KeyboardAccelerator Key="K" Invoked="PlayPauseKeyboardAccelerator_OnInvoked" />
                    <KeyboardAccelerator Key="Space" Invoked="PlayPauseKeyboardAccelerator_OnInvoked" />
                </Button.KeyboardAccelerators>
            </Button>
            <!--  Previous/Next  -->
            <StackPanel FlowDirection="LeftToRight" Orientation="Horizontal">
                <Button
                    x:Name="PreviousButton"
                    extensions:AcceleratorService.ToolTip="{x:Bind strings:Resources.Previous}"
                    AccessKey="{strings:KeyboardResources Key=PlayerPreviousKey}"
                    AutomationProperties.Name="{x:Bind PreviousButton.(extensions:AcceleratorService.ToolTip), Mode=OneWay}"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    Margin="0,0,16,0"
                    Style="{StaticResource RoundedFluentPlayerButtonStyle}">
                    <FontIcon
                        FontSize="18"
                        Glyph="&#xE892;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="PageUp" />
                        <KeyboardAccelerator Key="P" Modifiers="Shift" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button
                    x:Name="NextButton"
                    extensions:AcceleratorService.ToolTip="{x:Bind strings:Resources.Next}"
                    AccessKey="{strings:KeyboardResources Key=PlayerNextKey}"
                    AutomationProperties.Name="{x:Bind NextButton.(extensions:AcceleratorService.ToolTip), Mode=OneWay}"
                    Command="{x:Bind ViewModel.NextCommand}"
                    Margin="0,0,16,0"
                    Style="{StaticResource RoundedFluentPlayerButtonStyle}">
                    <FontIcon
                        FontSize="18"
                        Glyph="&#xE893;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="PageDown" />
                        <KeyboardAccelerator Key="N" Modifiers="Shift" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
            <!--  Time & Chapter  -->
            <controls:TimeDisplay
                x:Name="TimeDisplay"
                MinWidth="0"
                Margin="8,0,0,2"
                VerticalAlignment="Center"
                ChapterName="{x:Bind ViewModel.ChapterName, Mode=OneWay}"
                FontSize="17"
                Length="{x:Bind SeekBar.ViewModel.Length, Mode=OneWay}"
                ShowChapterName="{x:Bind ViewModel.PlayerShowChapters, Mode=TwoWay}"
                TextBlockStyle="{StaticResource BodyStrongTextBlockStyle}"
                Time="{x:Bind SeekBar.ViewModel.Time, Mode=OneWay}"
                TitleName="{x:Bind ViewModel.TitleName, Mode=OneWay}" />
        </StackPanel>
        <!--  Secondary Panel  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">



            <!--  Audio  -->
            <Button
                x:Name="AudioButton"
                Margin="0,0,18,0"
                extensions:AcceleratorService.ToolTip="{x:Bind strings:Resources.Audio}"
                AutomationProperties.Name="{x:Bind AudioButton.(extensions:AcceleratorService.ToolTip), Mode=OneWay}"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                Click="AudioButton_OnClick"
                Style="{StaticResource RoundedFluentPlayerButtonStyle}">
                <FontIcon
                    FontSize="18"
                    Glyph="&#xE7F6;"
                    MirroredWhenRightToLeft="True" />
            </Button>

            <!--  Captions  -->
            <Button
                x:Name="CaptionsButton"
                Margin="0,0,18,0"
                extensions:AcceleratorService.ToolTip="{x:Bind strings:Resources.Subtitles}"
                AutomationProperties.Name="{x:Bind CaptionsButton.(extensions:AcceleratorService.ToolTip), Mode=OneWay}"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                Click="CaptionsButton_OnClick"
                Style="{StaticResource RoundedFluentPlayerButtonStyle}">
                <FontIcon
                    FontSize="20"
                    Glyph="&#xE8C7;"
                    MirroredWhenRightToLeft="True" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Invoked="ToggleSubtitleKeyboardAccelerator_OnInvoked" />
                    <KeyboardAccelerator
                        Key="C"
                        Invoked="ToggleSubtitleKeyboardAccelerator_OnInvoked"
                        Modifiers="Control" />
                    <KeyboardAccelerator
                        Key="C"
                        Invoked="ToggleSubtitleKeyboardAccelerator_OnInvoked"
                        Modifiers="Control,Shift" />
                </Button.KeyboardAccelerators>
            </Button>

            <!--  Playlist Toggle  -->
            <Button
                x:Name="PlayQueueButton"
                Margin="0"
                extensions:AcceleratorService.ToolTip="{x:Bind strings:Resources.PlayQueue}"
                AccessKey="{x:Bind strings:KeyboardResources.PlayerQueueKey}"
                AllowDrop="True"
                AutomationProperties.Name="{x:Bind strings:Resources.PlayQueue}"
                Click="PlayQueueButton_OnClick"
                DragEnter="PlayQueueButton_OnDragEnter"
                DragLeave="PlayQueueButton_OnDragLeave"
                Style="{StaticResource RoundedFluentPlayerButtonStyle}">
                <FontIcon
                    x:Name="PlayQueueButtonIcon"
                    Margin="0,-2,0,0"
                    FontSize="18"
                    Glyph="&#xE838;"
                    MirroredWhenRightToLeft="True" />
            </Button>

            <!--  More  -->
            <Button
                x:Name="MoreButton"
                AccessKey="{strings:KeyboardResources Key=PlayerMoreKey}"
                AutomationProperties.Name="{x:Bind MoreButton.(ToolTipService.ToolTip)}"
                Flyout="{StaticResource NormalPlayerContextMenu}"
                IsAccessKeyScope="True"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                Style="{StaticResource RoundedFluentPlayerButtonStyle}"
                ToolTipService.ToolTip="{strings:Resources Key=More}"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="18"
                    Glyph="&#xE712;" />
            </Button>
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveControlStates">
                <VisualState x:Name="AdaptiveHidden">
                    <VisualState.StateTriggers>
                        <ui:ControlSizeTrigger
                            x:Name="AdaptiveHiddenControlSizeTrigger"
                            MaxWidth="720"
                            CanTrigger="{x:Bind ViewModel.ShouldBeAdaptive, Mode=OneWay}"
                            TargetElement="{x:Bind}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AudioButton.Visibility" Value="Collapsed" />
                        <Setter Target="CaptionsButton.Visibility" Value="Collapsed" />
                        <Setter Target="FullscreenMenuItem.Visibility" Value="Visible" />
                        <Setter Target="FullscreenMenuItemKeyboardAccelerator.IsEnabled" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactOverride">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsCompact, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AudioButton.Visibility" Value="Collapsed" />
                        <Setter Target="CaptionsButton.Visibility" Value="Collapsed" />
                        <Setter Target="PlayQueueButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="LayoutGroup">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Fullscreen">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsFullscreen, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsCompact, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlayPauseButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="PlayPauseButton.Margin" Value="4,0,0,0" />
                        <Setter Target="PreviousButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="NextButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="TimeDisplay.Margin" Value="4,0,0,0" />
                        <Setter Target="TimeDisplay.FontSize" Value="13" />
                        <Setter Target="MoreButton.Visibility" Value="Collapsed" />
                        <Setter Target="SeekBar.(Grid.Row)" Value="2" />
                        <Setter Target="SeekBar.Margin" Value="0" />
                        <Setter Target="SeekBar.ProgressOnly" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Mini">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsMinimal, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AdaptiveHiddenControlSizeTrigger.MaxWidth" Value="640" />
                        <Setter Target="PlayPauseButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="PreviousButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="NextButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="AudioButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="CaptionsButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="PlayQueueButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                        <Setter Target="MoreButton.Style" Value="{StaticResource SmallRoundedFluentPlayerButtonStyle}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
