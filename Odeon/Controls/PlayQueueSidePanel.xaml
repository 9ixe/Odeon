<UserControl
    x:Class="Odeon.Controls.PlayQueueSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Odeon.Behaviors"
    xmlns:converters="using:Odeon.Converters"
    xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:Odeon.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:Odeon.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Odeon.Core.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="380"
    mc:Ignorable="d"
    UseLayoutRounding="True"
    FontFamily="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/CommandBar.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <MenuFlyout x:Key="ItemFlyout">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.PlaySingleCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon FontFamily={StaticResource OdeonSymbolThemeFontFamily},
                                       Glyph={StaticResource PlayGlyph}}"
                    Text="{strings:Resources Key=Play}" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.PlayNextCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon FontFamily={StaticResource OdeonSymbolThemeFontFamily},
                                       Glyph={StaticResource PlayAddGlyph}}"
                    Text="{strings:Resources Key=PlayNext}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{StaticResource OpenWithCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon Glyph=&#xE7AC;}"
                    Text="{x:Bind strings:Resources.OpenWith}" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.RemoveCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon Glyph=&#xE894;}"
                    Text="{strings:Resources Key=Remove}" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.MoveItemUpCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon Glyph=&#xE74A;}"
                    Text="{strings:Resources Key=MoveUp}" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.MoveItemDownCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon Glyph=&#xE74B;}"
                    Text="{strings:Resources Key=MoveDown}" />
                <MenuFlyoutItem
                    Command="{StaticResource ShowPropertiesCommand}"
                    CommandParameter="{Binding}"
                    Icon="{ui:FontIcon Glyph=&#xE946;}"
                    Text="{strings:Resources Key=Properties}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.Selection.SelectItemCommand}"
                    CommandParameter="{Binding}"
                    Text="{x:Bind strings:Resources.Select}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon
                            x:Name="SelectMenuFlyoutItemIcon"
                            FontFamily="{StaticResource OdeonSymbolThemeFontFamily}"
                            Glyph="{StaticResource SingleSelectGlyph}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <Style x:Key="PlayQueueItemStyle" TargetType="ListViewItem">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TabNavigation" Value="Local" />
                <Setter Property="IsHoldingEnabled" Value="True" />
                <Setter Property="Margin" Value="2,1,2,1" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="14,0,10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid
                                x:Name="RootGrid"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Control.IsTemplateFocusTarget="True">
                                <Border
                                    x:Name="SelectedBackground"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Border
                                    x:Name="HoverBackground"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <Grid
                                    x:Name="IndicatorHost"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="IndicatorTranslate" />
                                    </Grid.RenderTransform>
                                    <Rectangle
                                        x:Name="SelectionIndicator"
                                        Width="3"
                                        Height="16"
                                        RadiusX="1.5"
                                        RadiusY="1.5"
                                        Fill="{ThemeResource SystemAccentColorBrush}"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform x:Name="IndicatorScale" ScaleY="0" />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="ContentTransform" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="HoverBackground.Opacity" Value="0" />
                                                <Setter Target="RootGrid.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverBackground.Opacity" Value="0.08" />
                                                <Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverBackground.Opacity" Value="0.18" />
                                                <Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverPressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverBackground.Opacity" Value="0.18" />
                                                <Setter Target="HoverBackground.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectionIndicator.Opacity" Value="0" />
                                                <Setter Target="IndicatorScale.ScaleY" Value="0" />
                                                <Setter Target="SelectedBackground.Opacity" Value="0" />
                                                <Setter Target="ContentTransform.X" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="SelectedBackground.Opacity" Value="1" />
                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                <Setter Target="IndicatorScale.ScaleY" Value="1" />
                                                <Setter Target="ContentTransform.X" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <VisualState.Setters>
                                                <Setter Target="SelectedBackground.Opacity" Value="1" />
                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                <Setter Target="IndicatorScale.ScaleY" Value="1" />
                                                <Setter Target="ContentTransform.X" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SelectedBackground.Opacity" Value="1" />
                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                <Setter Target="IndicatorScale.ScaleY" Value="1" />
                                                <Setter Target="ContentTransform.X" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="SelectedBackground.Opacity" Value="1" />
                                                <Setter Target="SelectionIndicator.Opacity" Value="1" />
                                                <Setter Target="IndicatorScale.ScaleY" Value="1" />
                                                <Setter Target="ContentTransform.X" Value="4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource SidePanelBackgroundBrush}"
        BorderThickness="0"
        CornerRadius="12"
        Padding="0,0,0,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="18,14,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{strings:Resources Key=PlayNext}"
                    FontWeight="SemiBold"
                    FontSize="18"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Button
                    Grid.Column="1"
                    x:Name="CloseButton"
                    Click="CloseButton_OnClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="0"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <!-- Action Buttons Row -->
            <StackPanel
                x:Name="ActionButtonRow"
                Grid.Row="1"
                Margin="8,0,8,8"
                Orientation="Horizontal"
                Spacing="4">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,4,12,4">
                    <Button
                        x:Name="AddFilesButton"
                        AutomationProperties.Name="{strings:Resources Key=AddFiles}"
                        Command="{x:Bind ViewModel.AddFilesCommand}"
                        Padding="0"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=AddFiles}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{strings:Resources Key=AddFiles}" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,4,12,4">
                    <Button
                        x:Name="ClearButton"
                        AutomationProperties.Name="{strings:Resources Key=Clear}"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        Padding="0"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=Clear}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource OdeonSymbolThemeFontFamily}" FontSize="12" Glyph="{StaticResource DeleteGlyph}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{strings:Resources Key=Clear}" />
                        </StackPanel>
                    </Button>
                </Border>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10,4,12,4">
                    <ToggleButton
                        x:Name="MultiSelectToggle"
                        AutomationProperties.Name="{strings:Resources Key=Multiselect}"
                        Padding="0"
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsChecked="{x:Bind ViewModel.Selection.IsSelectionModeActive, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                        Style="{StaticResource SubtleToggleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=Multiselect}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE762;" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{strings:Resources Key=Multiselect}" />
                        </StackPanel>
                    </ToggleButton>
                </Border>
            </StackPanel>

            <!-- Selection Command Bar (shown in multi-select mode) -->
            <Grid
                x:Name="SelectionCommandRow"
                Grid.Row="1"
                Margin="8,0,8,8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="SelectionCheckBox"
                    MinWidth="60"
                    Margin="4,0,4,0"
                    d:Content="11 items selected"
                    AutomationProperties.HelpText="{x:Bind strings:Resources.ItemsSelected(ViewModel.Selection.SelectedItems.Count), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind strings:Resources.SelectAll}"
                    Command="{StaticResource SelectDeselectAllCommand}"
                    CommandParameter="{x:Bind Path=PlaylistListView}"
                    Content="{x:Bind strings:Resources.ItemsSelected(ViewModel.Selection.SelectedItems.Count), Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.Selection.IsAllSelected, Mode=OneWay}"
                    IsThreeState="True"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Selection.IsAllSelected, Converter={StaticResource CheckBoxToToolTipConverter}, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button
                        AutomationProperties.Name="{strings:Resources Key=PlayNext}"
                        Command="{x:Bind ViewModel.PlaySelectedNextCommand}"
                        CommandParameter="{x:Bind PlaylistListView.SelectedItems}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=PlayNext}">
                        <FontIcon FontFamily="{StaticResource OdeonSymbolThemeFontFamily}" FontSize="14" Glyph="{StaticResource PlayAddGlyph}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{strings:Resources Key=Remove}"
                        Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                        CommandParameter="{x:Bind PlaylistListView.SelectedItems}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=Remove}">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{strings:Resources Key=MoveUp}"
                        Command="{x:Bind ViewModel.MoveSelectedItemUpCommand}"
                        CommandParameter="{x:Bind PlaylistListView.SelectedItems}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=MoveUp}">
                        <FontIcon FontSize="14" Glyph="&#xE74A;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{strings:Resources Key=MoveDown}"
                        Command="{x:Bind ViewModel.MoveSelectedItemDownCommand}"
                        CommandParameter="{x:Bind PlaylistListView.SelectedItems}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{strings:Resources Key=MoveDown}">
                        <FontIcon FontSize="14" Glyph="&#xE74B;" />
                    </Button>
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Padding="4,5"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.Selection.ClearSelectionCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{strings:Resources Key=ClearSelection}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="ButtonForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="ButtonForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="ButtonForeground" ResourceKey="SystemColorHighlightColorBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemColorButtonTextColorBrush" />
                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Queue Track List -->
            <ListView
                x:Name="PlaylistListView"
                Grid.Row="2"
                ItemsSource="{x:Bind QueueItems}"
                SelectionChanged="PlaylistListView_OnSelectionChanged"
                SingleSelectionFollowsFocus="False"
                MaxHeight="380"
                Padding="0"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                DragOver="PlaylistListView_OnDragOver"
                Drop="PlaylistListView_OnDrop"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                Margin="8,4,8,24"
                ItemContainerStyle="{StaticResource PlayQueueItemStyle}"
                ItemContainerTransitions="{x:Null}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MediaViewModel">
                        <TextBlock
                            Text="{x:Bind Name}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <interactivity:Interaction.Behaviors>
                    <behaviors:ListViewContextTriggerBehavior Flyout="{StaticResource ItemFlyout}" />
                    <behaviors:ListViewSelectionBehavior SelectedItems="{x:Bind ViewModel.Selection.SelectedItems}" />
                </interactivity:Interaction.Behaviors>
            </ListView>

            <!-- Empty State -->
            <TextBlock
                x:Name="EmptyMessage"
                Grid.Row="2"
                Margin="18,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.5"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Queue is empty"
                Visibility="Collapsed" />

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SelectionModes">
                    <VisualState x:Name="Multiple">
                        <VisualState.StateTriggers>
                            <StateTrigger IsActive="{x:Bind ViewModel.Selection.IsSelectionModeActive, Mode=OneWay}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SelectionCommandRow.Visibility" Value="Visible" />
                            <Setter Target="ActionButtonRow.Visibility" Value="Collapsed" />
                            <Setter Target="PlaylistListView.SelectionMode" Value="Multiple" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </Border>
</UserControl>
