<UserControl
    x:Class="Odeon.Controls.AudioSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Odeon.Behaviors"
    xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:strings="using:Odeon.Strings"
    xmlns:system="using:System"
    mc:Ignorable="d"
    UseLayoutRounding="True"
    FontFamily="ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/Progress.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular</FontFamily>
            <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/Linotte-Regular.otf#Linotte-Regular</FontFamily>
            <ctConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <media:AcrylicBrush
                        x:Key="SidePanelBackgroundBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="#1E1E1E"
                        TintColor="#141414"
                        TintOpacity="0.88" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <media:AcrylicBrush
                        x:Key="SidePanelBackgroundBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="#F4F4F4"
                        TintColor="#FAFAFA"
                        TintOpacity="0.88" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="#22000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SidePanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SidePanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource SidePanelBackgroundBrush}"
        BorderThickness="0"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Audio Track List (compact, exactly 4 visible at a time, scrollable for more) -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Divider -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: Audio Controls -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="18,14,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{strings:Resources Key=Audio}"
                    FontWeight="SemiBold"
                    FontSize="18"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Button
                    Grid.Column="1"
                    x:Name="CloseButton"
                    Click="CloseButton_OnClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="0"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ListView
                x:Name="AudioTrackListView"
                Grid.Row="1"
                ItemsSource="{x:Bind AudioDisplayList}"
                SelectionChanged="AudioTrackListView_OnSelectionChanged"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False"
                MaxHeight="144"
                Padding="0"
                ContainerContentChanging="AudioTrackListView_OnContainerContentChanging"
                PointerExited="AudioTrackListView_OnPointerExited"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                Margin="8,4,8,6"
                ItemContainerStyle="{StaticResource SidePanelTrackItemStyle}"
                ItemContainerTransitions="{x:Null}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="system:String">
                        <TextBlock
                            Text="{x:Bind}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Divider -->
            <Rectangle
                Grid.Row="2"
                Height="1"
                Fill="{ThemeResource SidePanelBorderBrush}"
                Margin="16,2,16,10" />

            <!-- Bottom: Audio Controls (clean flat layout, comfortable spacing) -->
            <Grid Grid.Row="3" Padding="18,0,18,24">
                <!-- DataContext is assigned from code-behind (see ApplySettingsDataContext): the
                     section binds to PlayerControlsViewModel while the panel itself is bound to
                     CompositeTrackPickerViewModel for the track list. -->
                <StackPanel
                    x:Name="SettingsSection"
                    Orientation="Vertical"
                    Spacing="8">
                    <!-- Audio Timing offset slider -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{strings:Resources Key=TimingOffset}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.8">
                            <Run Text="{Binding ElementName=AudioTimingOffsetSlider, Path=Value, FallbackValue=0}" /> <Run Text="ms" />
                        </TextBlock>
                    </Grid>
                    <Slider
                        x:Name="AudioTimingOffsetSlider"
                        Style="{StaticResource SidePanelSliderStyle}"
                        IsThumbToolTipEnabled="False"
                        Maximum="3000"
                        Minimum="-3000"
                        SmallChange="25"
                        StepFrequency="50"
                        Margin="0,2,0,2"
                        Padding="0"
                        Value="{Binding AudioTimingOffset, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
